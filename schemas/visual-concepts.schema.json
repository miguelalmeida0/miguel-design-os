{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miguel-design-os.local/schemas/visual-concepts.schema.json",
  "title": "Miguel Design OS Visual Concepts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectName",
    "selectedConceptId",
    "approvalStatus",
    "approvedBy",
    "approvalNotes",
    "concepts"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "minLength": 1
    },
    "selectedConceptId": {
      "type": "string"
    },
    "approvalStatus": {
      "type": "string",
      "enum": ["pending", "approved", "rejected"]
    },
    "approvedBy": {
      "type": "string"
    },
    "approvalNotes": {
      "type": "string"
    },
    "concepts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "visualMetaphor",
          "composition",
          "focalObject",
          "emotionalHook",
          "whatIsHidden",
          "whatIsAbsent",
          "clicheAvoidance",
          "desireMechanism",
          "desktop1440Strategy",
          "tablet768Strategy",
          "mobile390Strategy",
          "failureMode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "visualMetaphor": {
            "type": "string",
            "minLength": 1
          },
          "composition": {
            "type": "string",
            "minLength": 1
          },
          "focalObject": {
            "type": "string",
            "minLength": 1
          },
          "emotionalHook": {
            "type": "string",
            "minLength": 1
          },
          "whatIsHidden": {
            "type": "string",
            "minLength": 1
          },
          "whatIsAbsent": {
            "type": "string",
            "minLength": 1
          },
          "clicheAvoidance": {
            "type": "string",
            "minLength": 1
          },
          "desireMechanism": {
            "type": "string",
            "minLength": 1
          },
          "desktop1440Strategy": {
            "type": "string",
            "minLength": 1
          },
          "tablet768Strategy": {
            "type": "string",
            "minLength": 1
          },
          "mobile390Strategy": {
            "type": "string",
            "minLength": 1
          },
          "failureMode": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
