{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miguel-design-os.local/schemas/done-report.schema.json",
  "title": "Miguel Design OS Done Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectName",
    "taskType",
    "mode",
    "isVisualWork",
    "filesChanged",
    "commandsRun",
    "screenshots",
    "screenshotReportPath",
    "visualQa",
    "interactionQa",
    "assetQa",
    "targetCopyQa",
    "productQa",
    "score",
    "remainingWeaknesses",
    "blockers",
    "finalStatus"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "minLength": 1
    },
    "taskType": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["visual-concept", "literal-target-copy", "visual-repair", "implementation", "review"]
    },
    "isVisualWork": {
      "type": "boolean"
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commandsRun": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "screenshots": {
      "$ref": "#/$defs/viewportScreenshots"
    },
    "screenshotReportPath": {
      "type": "string"
    },
    "visualQa": {
      "$ref": "#/$defs/visualQa"
    },
    "interactionQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadButtons", "notes"],
      "properties": {
        "deadButtons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "assetQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "manifestPath", "validated", "notes"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "manifestPath": {
          "type": "string"
        },
        "validated": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "targetCopyQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reportPath", "validated", "notes"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reportPath": {
          "type": "string"
        },
        "validated": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "productQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appPurpose", "designOsTestPurpose", "rulesUnderTest", "coreLoopQa", "persistenceQa", "dogfoodQa"],
      "properties": {
        "appPurpose": {
          "type": "string"
        },
        "designOsTestPurpose": {
          "type": "string"
        },
        "rulesUnderTest": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coreLoopQa": {
          "$ref": "#/$defs/coreLoopQa"
        },
        "persistenceQa": {
          "$ref": "#/$defs/persistenceQa"
        },
        "dogfoodQa": {
          "$ref": "#/$defs/dogfoodQa"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "target"],
      "properties": {
        "current": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "target": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "remainingWeaknesses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finalStatus": {
      "type": "string",
      "enum": ["done", "blocked", "needs-work"]
    }
  },
  "$defs": {
    "viewportScreenshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["390", "768", "1440"],
      "properties": {
        "390": {
          "type": "string"
        },
        "768": {
          "type": "string"
        },
        "1440": {
          "type": "string"
        }
      }
    },
    "visualQa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "captureMode",
        "noOverlap",
        "noTextOnButtons",
        "noWatermark",
        "noHorizontalOverflow",
        "noCutHeroObject",
        "noCutHeroObjectJustification",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passing", "needs-work", "blocked", "manual-review"]
        },
        "captureMode": {
          "type": "string",
          "enum": ["automated", "manual-import", "blocked"]
        },
        "noOverlap": {
          "type": "boolean"
        },
        "noTextOnButtons": {
          "type": "boolean"
        },
        "noWatermark": {
          "type": "boolean"
        },
        "noHorizontalOverflow": {
          "type": "boolean"
        },
        "noCutHeroObject": {
          "type": "boolean"
        },
        "noCutHeroObjectJustification": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "coreLoopQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "loop", "manuallyVerified", "verificationNotes"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "loop": {
          "type": "string"
        },
        "manuallyVerified": {
          "type": "boolean"
        },
        "verificationNotes": {
          "type": "string"
        }
      }
    },
    "persistenceQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userGeneratedData", "routeChanges", "refresh", "browserReopen", "uiDisclosure"],
      "properties": {
        "userGeneratedData": {
          "type": "boolean"
        },
        "routeChanges": {
          "type": "string"
        },
        "refresh": {
          "type": "string"
        },
        "browserReopen": {
          "type": "string"
        },
        "uiDisclosure": {
          "type": "string"
        }
      }
    },
    "dogfoodQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isDogfoodTarget", "failuresBackPropagated", "learningNotes"],
      "properties": {
        "isDogfoodTarget": {
          "type": "boolean"
        },
        "failuresBackPropagated": {
          "type": "boolean"
        },
        "learningNotes": {
          "type": "string"
        }
      }
    }
  }
}
